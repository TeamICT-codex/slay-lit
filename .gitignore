# werkbestanden van de ontwikkelsessies
.claude/

# distributie-zip (wordt apart gebouwd)
*.zip

# schoten van de meet-/testsuites in tools/ (drama_shots, geo_shots, drama_c_shots, ...):
# zonder SLAYIT_SHOTS vallen die suites terug op een map NAAST het script, en rauwe PNG's
# horen nooit in de werkboom (projectafspraak art-pipeline). Zet SLAYIT_SHOTS naar de
# scratchpad en er belandt hier sowieso niets.
tools/*_shots/

# originelen-backups van het dambord-script (groot, niet nodig in het spel)
assets/*/originelen/

# bron-PNG's van vóór de WebP-conversie (lokaal archief)
assets-bron/

# bewust geparkeerde werkmap — NOOIT committen (afspraak):
# het design-system blijft lokaal (de proloog-art is sinds de vanilla-herbouw
# gewone gedeployde WebP in assets/proloog/; de PNG-bronnen zitten in assets-bron/)
design-system/
